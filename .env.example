# Copy to .env.local and fill in. Never commit .env.local or paste these values into chat.
# Until SHOPIFY_STORE_DOMAIN and SHOPIFY_STOREFRONT_PRIVATE_TOKEN are set, the site runs on the
# prototype's catalogue. See docs/Roadmap.md (Step 4) and docs/TRD.md §12.

# Store
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-10

# Headless sales channel → your storefront → Storefront API
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Admin API app for the store scripts (`pnpm shopify:setup`, `pnpm assets:images --upload`).
# Since 2026 custom apps are created in the Dev Dashboard (dev.shopify.com), in the same
# organization as the store, and installed on it. Paste its client ID and secret here; the scripts
# exchange them for a 24-hour token. (SHOPIFY_ADMIN_TOKEN still works for an older static token.)
# Scopes: write_products, write_inventory, read_locations, write_metaobject_definitions,
#         write_metaobjects, write_publications, write_files
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=
# Shopify signs webhooks with the app's client secret: use the same value here (/api/revalidate checks it).
SHOPIFY_WEBHOOK_SECRET=

# Customer accounts are deferred (guest checkout first), so these stay empty for now.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_SHOP_ID=
